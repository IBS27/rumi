# The local room editor runs without a backend; chat requires Clerk and Convex.
# Set only after your team assigns a development deployment.
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=
# Enable only after the authenticated capture backend is configured and synced.
VITE_CAPTURE_PAIRING_ENABLED=false
# Backend-only, set on the personal Convex deployment:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Optional exact hostname for a private development reverse proxy (no scheme/port).
RUMI_PREVIEW_HOST=

# Backend-only provider settings. Set separately in the personal Convex deployment.
# OPENAI_API_KEY=
# EXA_API_KEY=
# RUMI_AGENT_MODEL=gpt-4o
# RUMI_EXTRACTION_MODEL=gpt-4o-mini
# RUMI_IMAGE_MODEL=gpt-4o-mini
# RUMI_ASSET_MODEL=gpt-6-astra
# CHAT_ALLOWED_ORIGINS=http://localhost:5173
