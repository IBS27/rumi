# Frontend. Optional: the placeholder scaffold runs without a backend.
# Set only after your team assigns a development deployment.
VITE_CONVEX_URL=

# Backend secrets. These belong to the Convex deployment, not to this file:
#
#   bunx convex env set EXA_API_KEY <key>
#   bunx convex env set OPENAI_API_KEY <key>
#
# Copy them into .env.local only to run the search pipeline from a local script,
# where Bun loads them into process.env. .env.local is ignored by Git.
#
# Never give a secret a VITE_ prefix: those are compiled into the browser bundle.
#
EXA_API_KEY=2ce081da-6615-433f-842b-8e3d249d1ae2
